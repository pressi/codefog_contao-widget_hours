<h3><?= $this->generateLabel().$this->xlabel ?></h3>

<table class="tl_widgethours" id="ctrl_<?= $this->strId ?>">
    <thead>
    <tr>
        <?php foreach ($this->getTableHeaders() as $header): ?>
            <th><?= $header['label'] ?></th>
        <?php endforeach; ?>
    </tr>
    </thead>
    <tbody>
    <?php foreach ($this->getTableBody() as $rows): ?>
        <tr>
            <?php foreach ($rows as $row): ?>
                <td>
                    <div class="wh_labels">
                        <span class="wh_label tl_gray"><?= $GLOBALS['TL_LANG']['MSC']['wh_from'] ?></span>
                        <span class="wh_label tl_gray"><?= $GLOBALS['TL_LANG']['MSC']['wh_to'] ?></span>
                    </div>
                    <div class="wh_inputs">
                        <input type="text" name="<?= $row['from']['name'] ?>" id="<?= $row['from']['id'] ?>" class="tl_text" value="<?= $row['from']['value'] ?>">
                        <span class="wh_divider tl_gray">-</span>
                        <input type="text" name="<?= $row['to']['name'] ?>" id="<?= $row['to']['id'] ?>" class="tl_text" value="<?= $row['to']['value'] ?>">
                    </div>
                </td>
            <?php endforeach; ?>
        </tr>
    <?php endforeach; ?>
    </tbody>
    <?php if(count($footer = $this-getTableFooter())): ?>
    <tfoot>
        <tr>
            <?php foreach($footer as $day => $foot): ?>
                <td>
                    <?php if ($foot['closed]['show']): ?>
                    <div class="tl_checkbox_single_container">
                        <input type="hidden" name="<?= $foot['closed']['name'] ?>" value="">
                        <span>
                            <input type="checkbox" name="<?= $foot['closed']['name'] ?>" class="tl_checkbox" id="<?= $foot['closed']['id'] ?>" value="1"><label for="<?= $foot['closed']['id'] ?>"><?= $foot['closed']['label'] ?></label>
                        </span>
                    </div>
                    <?php endif; ?>
                    <?php if ($foot['inherit]['show']): ?>
                    <div class="tl_checkbox_single_container">
                        <input type="hidden" name="<?= $foot['inherit']['name'] ?>" value="">
                        <span>
                            <input type="checkbox" name="<?= $foot['inherit']['name'] ?>" class="tl_checkbox" id="<?= $foot['inherit']['id'] ?>" value="1"><label for="<?= $foot['inherit']['id'] ?>"><?= $foot['inherit']['label'] ?></label>
                        </span>
                    </div>

                    <div class="hidden-area inherit-select-container<?php if($foot['inherit']['checked']): ?> shown<?php endif; ?>">
                        <select name="<?= $foot['inherit']['select_name'] ?>" id="<?= $foot['inherit']['select_id'] ?>" class="tl_select">
                            <?php foreach($foot['inherit']['select_options'] as $option): ?>
                                <option value="<?= $option['value'] ?>"<?php if($option['selected']): ?> selected<?php endif; ?>><?= $option['label'] ?></option>
                            <?php endforeach; ?>
                        </select>
                    </div>
                    <?php endif; ?>
                </td>
            <?php endforeach; ?>
        </tr>
    </tfoot>
    <?php endif; ?>
</table>

<?= $this->getErrorAsHTML() ?>

<link rel="stylesheet" href="<?= \Contao\System::getContainer()->get('assets.packages')->getUrl('widget.css', 'codefog_widget_hours') ?>">
